                  "value": "<date>",
                  "description": "Date for which to retrieve the basket composition"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fundId",
                  "description": "(Required) Unique fund identifier"
                }
